<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SwingLoop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="StageBrush" Color="#FF09090B" />
            <SolidColorBrush x:Key="ChromeBrush" Color="#CC16161A" />
            <SolidColorBrush x:Key="PanelBrush" Color="#F21C1C21" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="GolferBrush" Color="#FF30D158" />
            <SolidColorBrush x:Key="IdleBrush" Color="#FF636366" />
            <SolidColorBrush x:Key="StarBrush" Color="#FFFFD60A" />
            <SolidColorBrush x:Key="CaptureBrush" Color="#FFFF453A" />

            <Style x:Key="ToolButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Margin" Value="0,20,0,8" />
                <Setter Property="CharacterSpacing" Value="40" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
