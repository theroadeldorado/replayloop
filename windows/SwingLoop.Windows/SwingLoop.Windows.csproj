<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SwingLoop</RootNamespace>
    <AssemblyName>SwingLoop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\SwingLoop.ico')">Assets\SwingLoop.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained: runs from the build folder, no MSIX install needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Use the PRI/MSIX build tasks from the Windows App SDK package, so `dotnet build` works without Visual Studio. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <!-- swingcore.dll is built by CMake from ../../core (see build.ps1). -->
    <SwingCoreDir Condition="'$(SwingCoreDir)' == ''">$(MSBuildThisFileDirectory)..\..\core\build\$(Platform)\Release</SwingCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(SwingCoreDir)\swingcore.dll" Link="swingcore.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(SwingCoreDir)\swingcore.dll')" />
    <Content Include="Models\*.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="WarnMissingCore" BeforeTargets="Build" Condition="!Exists('$(SwingCoreDir)\swingcore.dll')">
    <Warning Text="swingcore.dll not found in $(SwingCoreDir). Run build.ps1 (or build core/ with CMake) first, or the app will fail to start." />
  </Target>

</Project>
